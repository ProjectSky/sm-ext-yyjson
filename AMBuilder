import os

for cxx in builder.targets:
  binary = Extension.Library(builder, cxx, 'json.ext')
  arch = binary.compiler.target.arch

  binary.compiler.defines += [
    'YYJSON_DISABLE_INCR_READER', # disable incremental reader because it's not used in this extension
  ]

  binary.sources += [
    'third_party/yyjson/src/yyjson.c',
    'src/extension.cpp',
    'src/JsonManager.cpp',
    'src/JsonNatives.cpp',
    os.path.join(Extension.sm_root, 'public', 'smsdk_ext.cpp'),
  ]

  binary.compiler.includes += [
    os.path.join(builder.sourcePath, 'src'),
    os.path.join(builder.sourcePath, 'public'),
    os.path.join(builder.sourcePath, 'third_party', 'yyjson', 'src'),
  ]
 
  if binary.compiler.target.platform == 'windows':
    binary.sources += ['src/version.rc']

  Extension.extensions += [builder.Add(binary)]
